<style>

  @keyframes pageEnter { 0% { opacity: 0; transform: translateY(40px) scale(0.98); } 100% { opacity: 1; transform: translateY(0) scale(1); } }

  .hero { max-width: 800px; margin: 0 auto; padding: 4rem 2rem; text-align: center; position: relative; z-index: 1; animation: pageEnter 2.5s ease-out; }
  .hero h1 { font-size: 2.8rem; color: var(--bleu); line-height: 1.2; margin-bottom: 1.5rem; font-weight: 700; letter-spacing: -0.5px; }
  .highlight { color: var(--corail); }
  .hero-sub { font-size: 1.15rem; color: var(--texte); margin-bottom: 2.5rem; opacity: 0.85; line-height: 1.8; }
  .hero-buttons { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }

  .cta { display: inline-block; background: linear-gradient(135deg, var(--corail), #F5A623); color: var(--blanc); padding: 1.15rem 3rem; border-radius: 50px; font-size: 1.15rem; font-weight: 700; transition: transform 0.2s, box-shadow 0.3s; position: relative; overflow: hidden; }
  .cta:hover { transform: scale(1.05); box-shadow: 0 6px 20px rgba(232, 100, 74, 0.35); }
  .cta-shine::after { content: ''; position: absolute; top: 0; left: -100%; width: 60%; height: 100%; background: linear-gradient(90deg, transparent, rgba(255,255,255,0.4), transparent); animation: shine 3s ease-in-out infinite; }
  @keyframes shine { 0% { left: -100%; } 50% { left: 150%; } 100% { left: 150%; } }

  .cta-secondary { display: inline-block; background: linear-gradient(135deg, #1A6B5C, #2BAB7C); color: var(--blanc); padding: 1.1rem 2.8rem; border-radius: 50px; font-size: 1.1rem; font-weight: 700; transition: transform 0.2s, box-shadow 0.3s; border: none; position: relative; overflow: hidden; }
  .cta-secondary:hover { transform: scale(1.05); box-shadow: 0 6px 20px rgba(26, 107, 92, 0.35); }

  .cta-outline { display: inline-block; border: 2px solid var(--teal); color: var(--teal); padding: 0.8rem 2rem; border-radius: 50px; font-size: 1rem; font-weight: 600; transition: all 0.3s ease; }
  .cta-outline:hover { background: linear-gradient(135deg, #1A6B5C, #2BAB7C); color: var(--blanc); border-color: #1A6B5C; transform: scale(1.03); box-shadow: 0 4px 15px rgba(26, 107, 92, 0.3); }

  .benefices, .pourquoi { max-width: 1100px; margin: 0 auto; padding: 5rem 2rem; text-align: center; position: relative; z-index: 1; }
  .benefices h2, .pourquoi h2 { font-size: 2rem; color: var(--bleu); margin-bottom: 3rem; font-weight: 600; }
  .pourquoi-intro { font-size: 1.05rem; color: var(--texte); max-width: 700px; margin: 0 auto 3rem; line-height: 1.8; opacity: 0.85; }



  /* === ROUE « Pourquoi le soroban ? » === */
  .roue-section { display: grid; grid-template-columns: 1fr 1fr; gap: 3rem; align-items: center; text-align: left; }
  .roue { position: relative; width: min(440px, 100%); aspect-ratio: 1; margin: 0 auto; }
  /* Disque blanc avec les 4 quarts en pastel (corail / jaune), comme les anciennes cartes de bénéfices */
  .roue-fond { position: absolute; inset: 0; border-radius: 50%; background: var(--blanc); box-shadow: 0 8px 30px rgba(0,0,0,0.08); }
  .roue-fond::before { content: ''; position: absolute; inset: 0; border-radius: 50%; background: conic-gradient(from -45deg, rgba(232,100,74,0.10) 0deg 90deg, rgba(245,166,35,0.13) 90deg 180deg, rgba(232,100,74,0.10) 180deg 270deg, rgba(245,166,35,0.13) 270deg 360deg); }
  /* Quart jaune qui tourne vers la zone active */
  .roue-indicateur { position: absolute; inset: 0; border-radius: 50%; background: conic-gradient(from -45deg, var(--jaune) 0deg 90deg, transparent 90deg 360deg); transition: transform 0.6s cubic-bezier(0.22, 1, 0.36, 1); }
  .roue-traits { position: absolute; inset: 0; }
  .roue-traits::before, .roue-traits::after { content: ''; position: absolute; top: 50%; left: 0; width: 100%; height: 4px; margin-top: -2px; background: var(--blanc); transform: rotate(45deg); }
  .roue-traits::after { transform: rotate(-45deg); }
  /* Grille 2×2 tournée de 45° : chaque case devient un quart de roue (haut, droite, bas, gauche) */
  .roue-zones { position: absolute; inset: 0; border-radius: 50%; overflow: hidden; display: grid; grid-template-columns: 1fr 1fr; grid-template-rows: 1fr 1fr; transform: rotate(45deg); }
