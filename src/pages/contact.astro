---
import Base from '../layouts/Base.astro';
---

<Base title="Contact">

  <section class="contact-hero fade-in">
    <h1>Une question ? <span class="highlight">Parlons-en</span></h1>
    <p>On te répond sous 24h. N'hésite pas, on est là pour t'aider.</p>
  </section>

  <section class="contact-grid fade-right">

    <div class="contact-cards">
      <a href="mailto:contact@soroclub.fr" class="contact-card">
        <div class="contact-card-icon" style="background: rgba(232,100,74,0.1);"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#E8644A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m22 7-8.991 5.727a2 2 0 0 1-2.009 0L2 7"/><rect x="2" y="4" width="20" height="16" rx="2"/></svg></div>
        <h3>Email</h3>
        <span class="contact-link">contact@soroclub.fr</span>
      </a>
      <a href="https://wa.me/33618354388" target="_blank" class="contact-card">
        <div class="contact-card-icon" style="background: rgba(43,171,124,0.1);"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#2BAB7C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M13.832 16.568a1 1 0 0 0 1.213-.303l.355-.465A2 2 0 0 1 17 15h3a2 2 0 0 1 2 2v3a2 2 0 0 1-2 2A18 18 0 0 1 2 4a2 2 0 0 1 2-2h3a2 2 0 0 1 2 2v3a2 2 0 0 1-.8 1.6l-.468.351a1 1 0 0 0-.292 1.233 14 14 0 0 0 6.392 6.384"/></svg></div>
        <h3>WhatsApp</h3>
        <span class="contact-link">Parlons-en !</span>
      </a>
      <a href="https://www.instagram.com/soroclub.fr" target="_blank" class="contact-card">
        <div class="contact-card-icon" style="background: rgba(245,166,35,0.1);"><svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="#F5A623" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="20" height="20" x="2" y="2" rx="5" ry="5"/><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"/><line x1="17.5" x2="17.51" y1="6.5" y2="6.5"/></svg></div>
        <h3>Instagram</h3>
        <span class="contact-link">@soroclub.fr</span>
      </a>
    </div>

    <div class="contact-form-wrapper fade-left">
      <h2 class="section-title">Envoie-nous un <span class="highlight">message</span></h2>
      <form class="contact-form" action="https://formsubmit.co/contact@soroclub.fr" method="POST">
        <input type="hidden" name="_subject" value="Nouveau message depuis Soroclub.fr">
        <input type="hidden" name="_captcha" value="false">
        <input type="hidden" name="_next" value="https://soroclub.fr/contact">

        <div class="form-group">
          <label for="name">Prénom</label>
          <input type="text" id="name" name="name" placeholder="Ton prénom" required>
        </div>

        <div class="form-group">
          <label for="email">Email</label>
          <input type="email" id="email" name="email" placeholder="ton@email.com" required>
        </div>

        <div class="form-group">
          <label for="subject">Sujet</label>
          <select id="subject" name="subject" required>
            <option value="" disabled selected>Choisis un sujet</option>
            <option value="Cours d'essai">Cours d'essai</option>
            <option value="Soroban">Soroban — infos</option>
            <option value="Soutien scolaire">Soutien scolaire — infos</option>
            <option value="Tarifs">Tarifs</option>
            <option value="Autre">Autre question</option>
          </select>
        </div>

        <div class="form-group">
          <label for="message">Message</label>
          <textarea id="message" name="message" rows="5" placeholder="Écris ton message ici..." required></textarea>
        </div>

        <button type="submit" class="cta cta-shine">Envoyer</button>
      </form>
    </div>

  </section>

</Base>

<style>
  .contact-hero {
    max-width: 800px; margin: 0 auto; padding: 4rem 2rem 2rem;
    text-align: center; animation: pageEnter 2.5s ease-out;
  }
  @keyframes pageEnter { 0% { opacity: 0; transform: translateY(40px) scale(0.98); } 100% { opacity: 1; transform: translateY(0) scale(1); } }
  .contact-hero h1 { font-size: 2.5rem; color: var(--bleu); font-weight: 700; margin-bottom: 1.5rem; }
  .highlight { color: var(--corail); }
  .contact-hero p { font-size: 1.1rem; color: var(--texte); opacity: 0.85; line-height: 1.8; }

  .contact-grid {
    max-width: 1000px; margin: 0 auto; padding: 3rem 2rem 5rem;
    display: grid; grid-template-columns: 1fr 2fr; gap: 3rem; align-items: start;
  }

  .contact-cards { display: flex; flex-direction: column; gap: 1.5rem; }

  .contact-card {
    background-color: var(--blanc); border-radius: 16px; padding: 1.5rem;
    text-align: center; box-shadow: 0 4px 15px rgba(0,0,0,0.05);
    transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease;
    border: 2px solid transparent; display: block; color: inherit;
  }
  .contact-card:hover { transform: translateY(-4px) scale(1.02); box-shadow: 0 8px 25px rgba(0,0,0,0.1); border-color: var(--jaune); }

  .contact-card-icon {
    width: 48px; height: 48px; border-radius: 12px;
    display: flex; align-items: center; justify-content: center;
    margin: 0 auto 0.75rem;
  }
  .contact-card h3 { font-size: 1rem; color: var(--bleu); font-weight: 600; margin-bottom: 0.4rem; }
  .contact-link { font-size: 0.85rem; color: var(--teal); font-weight: 500; word-break: break-all; }

  .contact-form-wrapper {
    background-color: var(--blanc); border-radius: 20px; padding: 2.5rem;
    box-shadow: 0 4px 15px rgba(0,0,0,0.05); overflow: hidden;
  }
  .contact-form-wrapper h2 { font-size: 1.4rem; color: var(--bleu); font-weight: 600; margin-bottom: 2rem; }
  .contact-form { display: flex; flex-direction: column; gap: 1.2rem; }
  .form-group { display: flex; flex-direction: column; gap: 0.4rem; }
  .form-group label { font-size: 0.9rem; color: var(--bleu); font-weight: 500; }

  .form-group input,
  .form-group select,
  .form-group textarea {
    width: 100%; box-sizing: border-box;
    padding: 0.8rem 1rem; border: 1.5px solid #ddd; border-radius: 10px;
    font-size: 0.95rem; font-family: 'Poppins', sans-serif;
    color: var(--texte); background-color: var(--creme);
    transition: border-color 0.2s, box-shadow 0.2s;
  }
  .form-group input:focus,
  .form-group select:focus,
  .form-group textarea:focus {
    outline: none; border-color: var(--teal);
    box-shadow: 0 0 0 3px rgba(26, 107, 92, 0.1);
  }
  .form-group textarea { resize: vertical; }

  .cta {
    display: inline-block;
    background: linear-gradient(135deg, var(--corail), #F5A623);
    color: var(--blanc); padding: 1rem 2.5rem; border-radius: 50px;
    font-size: 1.05rem; font-weight: 700; border: none; cursor: pointer;
    font-family: 'Poppins', sans-serif;
    transition: transform 0.2s, box-shadow 0.3s;
    align-self: flex-start; position: relative; overflow: hidden;
  }
  .cta:hover { transform: scale(1.03); box-shadow: 0 6px 20px rgba(232,100,74,0.3); }
  .cta-shine::after { content: ''; position: absolute; top: 0; left: -100%; width: 60%; height: 100%; background: linear-gradient(90deg, transparent, rgba(255,255,255,0.4), transparent); animation: shine 3s ease-in-out infinite; }
  @keyframes shine { 0% { left: -100%; } 50% { left: 150%; } 100% { left: 150%; } }

  @media (max-width: 768px) {
    .contact-hero h1 { font-size: 1.8rem; }
    .contact-hero { padding: 2rem 1.5rem 1rem; }

    .contact-grid {
      grid-template-columns: 1fr;
      padding: 2rem 1.5rem 3rem;
      gap: 2rem;
    }

    .contact-cards {
      flex-direction: column;
      gap: 1rem;
    }

    .contact-card {
      display: flex;
      flex-direction: row;
      align-items: center;
      gap: 1rem;
      text-align: left;
      padding: 1rem 1.2rem;
    }

    .contact-card-icon {
      width: 40px; height: 40px; border-radius: 10px;
      margin: 0; flex-shrink: 0;
    }

    .contact-card h3 { font-size: 0.9rem; margin-bottom: 0.2rem; }
    .contact-link { font-size: 0.8rem; }

    .contact-form-wrapper { padding: 1.5rem; }
    .contact-form-wrapper h2 { font-size: 1.2rem; margin-bottom: 1.5rem; }

    .form-group input,
    .form-group select,
    .form-group textarea {
      font-size: 0.9rem;
      padding: 0.7rem 0.8rem;
    }

    .cta { width: 100%; text-align: center; padding: 0.9rem; }
  }
</style>
