---
// Carte des tarifs Soutien scolaire, affichée sur /tarifs (onglet Soutien) et sur /soutien-scolaire
import { stripe } from '../data/stripe';

interface Props {
  /** Niveau du titre selon la page : h2 sur /tarifs, h3 sur /soutien-scolaire (sous « Nos tarifs ») */
  niveau?: 'h2' | 'h3';
}
const { niveau = 'h2' } = Astro.props;
const Titre = niveau;
---

<div class="pack">
  <div class="pack-header">
    <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect width="16" height="20" x="4" y="2" rx="2"/><line x1="8" x2="16" y1="6" y2="6"/><line x1="16" x2="16" y1="14" y2="18"/><path d="M16 10h.01"/><path d="M12 10h.01"/><path d="M8 10h.01"/><path d="M12 14h.01"/><path d="M8 14h.01"/><path d="M12 18h.01"/><path d="M8 18h.01"/></svg>
    <Titre>Soutien scolaire</Titre>
    <p class="pack-desc">Maths & français. Cours individuels de 30 min, suivi personnalisé.</p>
    <p class="pack-rythme"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M8 2v4"/><path d="M16 2v4"/><rect width="18" height="18" x="3" y="4" rx="2"/><path d="M3 10h18"/><path d="m9 16 2 2 4-4"/></svg>Abonnement mensuel, résiliable à tout moment</p>
  </div>
  <div class="pack-body">
    <div class="formule">
      <div class="formule-info"><p class="formule-titre">1 cours par semaine</p></div>
      <div class="formule-prix">
        <div class="formule-montant"><span class="prix">29€</span><span class="par-heure">par mois</span></div>
        <a href={stripe.soutien1x} target="_blank" class="btn-acheter">S'abonner</a>
      </div>
    </div>
    <div class="formule populaire">
      <div class="formule-tag">Meilleur rapport</div>
      <div class="formule-info"><p class="formule-titre">2 cours par semaine</p></div>
      <div class="formule-prix">
        <div class="formule-montant"><span class="prix">52€</span><span class="par-heure">par mois</span></div>
        <a href={stripe.soutien2x} target="_blank" class="btn-acheter">S'abonner</a>
      </div>
    </div>
  </div>
</div>

<style>
  .pack {
    background-color: var(--blanc); border-radius: 20px; overflow: hidden; text-align: left;
    box-shadow: 0 4px 15px rgba(0,0,0,0.05);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    border: 2px solid transparent;
  }
  .pack:hover { transform: translateY(-4px); box-shadow: 0 12px 30px rgba(0,0,0,0.1); border-color: var(--jaune); }

  .pack-header { background: linear-gradient(135deg, var(--corail) 0%, #D4553B 100%); padding: 2rem; color: var(--blanc); display: flex; flex-direction: column; gap: 0.5rem; }
  .pack-header svg { margin-bottom: 0.3rem; }
  .pack-header :is(h2, h3) { font-size: 1.5rem; font-weight: 700; }
  .pack-desc { font-size: 0.95rem; opacity: 0.9; }
  /* Pastille du rythme des cours, bien visible, calée en bas de l'en-tête (alignée d'une carte à l'autre) */
  .pack-rythme { align-self: flex-start; display: inline-flex; align-items: center; gap: 0.5rem; margin-top: auto; padding: 0.45rem 1rem; border-radius: 50px; background: rgba(255,255,255,0.18); color: var(--blanc); font-size: 0.95rem; font-weight: 600; }
  .pack-body { padding: 1.5rem 2rem 2rem; display: flex; flex-direction: column; gap: 1rem; }

  .formule { display: flex; justify-content: space-between; align-items: center; padding: 1rem 1.25rem; border-radius: 12px; background-color: var(--blanc); border: 1px solid #E3E8EE; position: relative; gap: 1rem; transition: background-color 0.2s ease, border-color 0.2s ease; }
  .formule:hover { background-color: #FAFBFC; border-color: #CBD3DD; }
  .formule.populaire { border: 2px solid var(--jaune); background-color: #FFFBF2; padding-top: 1.4rem; }
  .formule-tag { position: absolute; top: -10px; left: 1rem; background-color: var(--jaune); color: var(--blanc); font-size: 0.75rem; font-weight: 600; padding: 0.2rem 0.8rem; border-radius: 50px; }
  .formule-titre { font-size: 1.05rem; color: var(--bleu); font-weight: 600; }
  .formule-prix { display: flex; align-items: center; gap: 1.25rem; }
  .formule-montant { display: flex; flex-direction: column; align-items: flex-end; text-align: right; line-height: 1.25; }
  .prix { font-size: 1.6rem; font-weight: 700; color: var(--corail); }
  .par-heure { font-size: 0.8rem; color: #5F6B78; margin-top: 0.15rem; }

  .btn-acheter { display: inline-block; background: linear-gradient(135deg, var(--corail), #F5A623); color: var(--blanc); padding: 0.4rem 1.2rem; border-radius: 50px; font-size: 0.85rem; font-weight: 600; transition: transform 0.2s, box-shadow 0.2s, background 0.2s, color 0.2s; }
  .btn-acheter:hover { transform: scale(1.05); box-shadow: 0 4px 12px rgba(232,100,74,0.3); }
  /* Seule l'offre mise en avant garde le bouton plein, l'autre passe en contour */
  .formule:not(.populaire) .btn-acheter { background: none; color: var(--corail); box-shadow: inset 0 0 0 2px var(--corail); }
  .formule:not(.populaire) .btn-acheter:hover { background: var(--corail); color: var(--blanc); }

  @media (max-width: 768px) {
    .pack-header { padding: 1.5rem; }
    .pack-body { padding: 1.25rem 1rem 1.5rem; }
    .formule { padding: 0.9rem 1rem; }
    .formule.populaire { padding-top: 1.3rem; }
    /* Mobile : durée + montant sur une ligne, bouton sur toute la largeur en dessous */
    .formule { flex-wrap: wrap; }
    .formule-prix { display: contents; }
    .btn-acheter { flex-basis: 100%; text-align: center; padding: 0.6rem 1rem; }
  }
</style>
