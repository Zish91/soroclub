---
import Base from '../layouts/Base.astro';
---

<Base title="Accueil">

<div class="floating-symbols">
  <span class="symbol">+</span>
  <span class="symbol">×</span>
  <span class="symbol">★</span>
  <span class="symbol">√</span>
  <span class="symbol">÷</span>
  <span class="symbol">=</span>
  <span class="symbol">+</span>
  <span class="symbol">★</span>
  <span class="symbol">×</span>
  <span class="symbol">√</span>
  <span class="symbol">÷</span>
  <span class="symbol">=</span>
</div>

<section class="hero fade-in">
    <h1>Apprends le calcul mental<br />avec le <span class="highlight">soroban</span></h1>
    <p class="hero-sub">Des cours en ligne pour enfants de 6 à 12 ans.<br />Ludiques, progressifs, et efficaces.</p>
    <div class="hero-buttons">
      <a href="/reservation" class="cta cta-pulse cta-shine">Cours d'essai · 5€</a>
      <a href="/tarifs" class="cta-outline">Voir nos formules →</a>
    </div>
  </section>

  <section class="benefices fade-in">
    <h2 class="section-title">Pourquoi le soroban ?</h2>
    <div class="cards stagger" id="cards-dock">
      <div class="card">
        <span class="icon-bounce" style="background: rgba(232,100,74,0.1);">
          <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#E8644A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 18V5"/><path d="M15 13a4.17 4.17 0 0 1-3-4 4.17 4.17 0 0 1-3 4"/><path d="M17.598 6.5A3 3 0 1 0 12 5a3 3 0 1 0-5.598 1.5"/><path d="M17.997 5.125a4 4 0 0 1 2.526 5.77"/><path d="M18 18a4 4 0 0 0 2-7.464"/><path d="M19.967 17.483A4 4 0 1 1 12 18a4 4 0 1 1-7.967-.517"/><path d="M6 18a4 4 0 0 1-2-7.464"/><path d="M6.003 5.125a4 4 0 0 0-2.526 5.77"/></svg>
        </span>
        <h3>Calcul mental</h3>
        <p>Ton enfant apprend à visualiser le boulier mentalement pour calculer à une vitesse fulgurante, sans calculatrice.</p>
      </div>
      <div class="card">
        <span class="icon-bounce" style="background: rgba(245,166,35,0.1);">
          <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#F5A623" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/></svg>
        </span>
        <h3>Concentration</h3>
        <p>Manipuler les perles demande une attention totale. Cette habitude se transfère dans toutes les matières à l'école.</p>
      </div>
      <div class="card">
        <span class="icon-bounce" style="background: rgba(232,100,74,0.1);">
          <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#E8644A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11.017 2.814a1 1 0 0 1 1.966 0l1.051 5.558a2 2 0 0 0 1.594 1.594l5.558 1.051a1 1 0 0 1 0 1.966l-5.558 1.051a2 2 0 0 0-1.594 1.594l-1.051 5.558a1 1 0 0 1-1.966 0l-1.051-5.558a2 2 0 0 0-1.594-1.594l-5.558-1.051a1 1 0 0 1 0-1.966l5.558-1.051a2 2 0 0 0 1.594-1.594z"/><path d="M20 2v4"/><path d="M22 4h-4"/><circle cx="4" cy="20" r="2"/></svg>
        </span>
        <h3>Confiance en soi</h3>
        <p>Fini les "je suis nul en maths". En maîtrisant le calcul, ton enfant retrouve le plaisir d'apprendre.</p>
      </div>
      <div class="card">
        <span class="icon-bounce" style="background: rgba(245,166,35,0.1);">
          <svg width="36" height="36" viewBox="0 0 24 24" fill="none" stroke="#F5A623" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M15.39 4.39a1 1 0 0 0 1.68-.474 2.5 2.5 0 1 1 3.014 3.015 1 1 0 0 0-.474 1.68l1.683 1.682a2.414 2.414 0 0 1 0 3.414L19.61 15.39a1 1 0 0 1-1.68-.474 2.5 2.5 0 1 0-3.014 3.015 1 1 0 0 1 .474 1.68l-1.683 1.682a2.414 2.414 0 0 1-3.414 0L8.61 19.61a1 1 0 0 0-1.68.474 2.5 2.5 0 1 1-3.014-3.015 1 1 0 0 0 .474-1.68l-1.683-1.682a2.414 2.414 0 0 1 0-3.414L4.39 8.61a1 1 0 0 1 1.68.474 2.5 2.5 0 1 0 3.014-3.015 1 1 0 0 1-.474-1.68l1.683-1.682a2.414 2.414 0 0 1 3.414 0z"/></svg>
        </span>
        <h3>Stimulation cérébrale</h3>
        <p>Le soroban active les deux hémisphères du cerveau : la logique à gauche, la visualisation et la créativité à droite.</p>
      </div>
    </div>
  </section>

  <section class="etapes fade-in">
    <h2 class="section-title">Comment ça marche ?</h2>
    <div class="etapes-grid">
      <a href="/reservation" class="etape etape-link">
        <span class="etape-num">1</span>
        <h3>Réserve ton cours d'essai</h3>
        <p>Choisis un créneau en ligne. Le premier cours est offert pour découvrir la méthode.</p>
      </a>
      <a href="/programme" class="etape etape-link">
        <span class="etape-num">2</span>
        <h3>Apprends avec ton soroban</h3>
        <p>En visio, ton enfant manipule son boulier avec un professeur passionné. Ludique et interactif.</p>
      </a>
      <a href="/programme" class="etape etape-link">
        <span class="etape-num">3</span>
        <h3>Progresse niveau par niveau</h3>
        <p>Du débutant au calcul mental avancé, chaque niveau est validé par un examen. Comme les ceintures en judo !</p>
      </a>
    </div>
  </section>

  <section class="pourquoi fade-in">
    <h2 class="section-title">Pourquoi Soroclub ?</h2>
    <p class="pourquoi-intro">Fondée par <strong>Ibtissama</strong>, enseignante Montessori depuis plus de 10 ans et coach diplômée à la méthode soroban. Tous nos enseignants sont formés à sa pédagogie bienveillante.</p>
    <div class="pourquoi-grid stagger" id="pourquoi-dock">
      <div class="pourquoi-item">
        <span class="icon-bounce" style="background: rgba(27,58,92,0.1);">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#1B3A5C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21.42 10.922a1 1 0 0 0-.019-1.838L12.83 5.18a2 2 0 0 0-1.66 0L2.6 9.08a1 1 0 0 0 0 1.832l8.57 3.908a2 2 0 0 0 1.66 0z"/><path d="M22 10v6"/><path d="M6 12.5V16a6 3 0 0 0 12 0v-3.5"/></svg>
        </span>
        <h3>Enseignante certifiée</h3>
        <p>Une méthode conçue par une experte, avec 10 ans de pédagogie Montessori et une certification soroban.</p>
      </div>
      <div class="pourquoi-item">
        <span class="icon-bounce" style="background: rgba(43,171,124,0.1);">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#2BAB7C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m12 10 2 4v3a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1v-3a8 8 0 1 0-16 0v3a1 1 0 0 0 1 1h2a1 1 0 0 0 1-1v-3l2-4h4Z"/><path d="M4.82 7.9 8 10"/><path d="M15.18 7.9 12 10"/><path d="M16.93 10H20a2 2 0 0 1 0 4H2"/></svg>
        </span>
        <h3>On ne brûle pas les étapes</h3>
        <p>Chaque enfant avance à son rythme. Pas de pression, pas de course. La maîtrise avant la vitesse.</p>
      </div>
      <div class="pourquoi-item">
        <span class="icon-bounce" style="background: rgba(27,58,92,0.1);">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#1B3A5C" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m16 11 2 2 4-4"/><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
        </span>
        <h3>Suivi personnalisé</h3>
        <p>Des petits groupes pour un vrai accompagnement. Chaque enfant est suivi individuellement.</p>
      </div>
      <div class="pourquoi-item">
        <span class="icon-bounce" style="background: rgba(232,100,74,0.1);">
          <svg width="32" height="32" viewBox="0 0 24 24" fill="none" stroke="#E8644A" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M2 9.5a5.5 5.5 0 0 1 9.591-3.676.56.56 0 0 0 .818 0A5.49 5.49 0 0 1 22 9.5c0 2.29-1.5 4-3 5.5l-5.492 5.313a2 2 0 0 1-3 .019L5 15c-1.5-1.5-3-3.2-3-5.5"/></svg>
        </span>
        <h3>Zéro stress</h3>
        <p>L'erreur fait partie de l'apprentissage. Ici on encourage, on ne juge pas.</p>
      </div>
    </div>
  </section>

  <section class="chiffres fade-in">
    <div class="chiffres-grid stagger">
      <a href="/temoignages" class="chiffre-item chiffre-link">
        <span class="chiffre-num" data-target="40">0</span>
        <span class="chiffre-suffix">+</span>
        <p>élèves accompagnés</p>
      </a>
      <a href="/programme" class="chiffre-item chiffre-link">
        <span class="chiffre-num" data-target="10">0</span>
        <span class="chiffre-suffix">+</span>
        <p>ans d'expérience</p>
      </a>
      <a href="/programme" class="chiffre-item chiffre-link">
        <span class="chiffre-num" data-target="9">0</span>
        <span class="chiffre-suffix"></span>
        <p>niveaux progressifs</p>
      </a>
      <a href="/reservation" class="chiffre-item chiffre-link">
        <span class="chiffre-num" data-target="5">0</span>
        <span class="chiffre-suffix">€</span>
        <p>le cours d'essai</p>
      </a>
    </div>
  </section>

  <section class="cta-final fade-in">
    <h2>Prêt à commencer ?</h2>
    <p>Offre à ton enfant un super pouvoir en mathématiques.</p>
    <a href="/reservation" class="cta cta-pulse cta-shine">Cours d'essai · 5€</a>
  </section>

</Base>

<style>
  .floating-symbols {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
    z-index: 0;
  }

  .symbol {
    position: absolute;
    font-weight: 700;
    opacity: 0.25;
  }

  .symbol:nth-child(1) { font-size: 2.5rem; color: var(--corail); top: 12%; left: 6%; animation: float 6s ease-in-out infinite; }
  .symbol:nth-child(2) { font-size: 2rem; color: var(--jaune); top: 55%; left: 90%; animation: float 7s ease-in-out infinite 1s; }
  .symbol:nth-child(3) { font-size: 3rem; color: var(--teal); top: 78%; left: 22%; animation: float 8s ease-in-out infinite 2s; }
  .symbol:nth-child(4) { font-size: 2.2rem; color: var(--corail); top: 6%; left: 75%; animation: float 6.5s ease-in-out infinite 0.5s; }
  .symbol:nth-child(5) { font-size: 2rem; color: var(--jaune); top: 42%; left: 3%; animation: float 7.5s ease-in-out infinite 1.5s; }
  .symbol:nth-child(6) { font-size: 2.8rem; color: var(--teal); top: 22%; left: 93%; animation: float 6s ease-in-out infinite 3s; }
  .symbol:nth-child(7) { font-size: 1.8rem; color: var(--bleu-clair); top: 68%; left: 58%; animation: float 7s ease-in-out infinite 2.5s; }
  .symbol:nth-child(8) { font-size: 2.4rem; color: var(--jaune); top: 32%; left: 42%; animation: float 8s ease-in-out infinite 4s; }
  .symbol:nth-child(9) { font-size: 1.6rem; color: var(--corail); top: 88%; left: 70%; animation: float 6.5s ease-in-out infinite 1.2s; }
  .symbol:nth-child(10) { font-size: 2.6rem; color: var(--teal); top: 48%; left: 78%; animation: float 7.5s ease-in-out infinite 3.5s; }
  .symbol:nth-child(11) { font-size: 1.9rem; color: var(--jaune); top: 92%; left: 12%; animation: float 6s ease-in-out infinite 2.2s; }
  .symbol:nth-child(12) { font-size: 2.1rem; color: var(--bleu-clair); top: 3%; left: 45%; animation: float 7s ease-in-out infinite 0.8s; }

  @keyframes float {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(-20px) rotate(10deg); }
  }

  .hero {
    max-width: 800px;
    margin: 0 auto;
    padding: 4rem 2rem;
    text-align: center;
    position: relative;
    z-index: 1;
  }

  .hero h1 { font-size: 2.8rem; color: var(--bleu); line-height: 1.2; margin-bottom: 1.5rem; font-weight: 700; letter-spacing: -0.5px; }
  .highlight { color: var(--corail); }
  .hero-sub { font-size: 1.15rem; color: var(--texte); margin-bottom: 2.5rem; opacity: 0.85; line-height: 1.8; }

  .hero-buttons { display: flex; gap: 1rem; justify-content: center; flex-wrap: wrap; }

  .cta {
    display: inline-block;
    background: linear-gradient(135deg, var(--corail), #F5A623);
    color: var(--blanc);
    padding: 1.15rem 3rem;
    border-radius: 50px;
    font-size: 1.15rem;
    font-weight: 700;
    transition: transform 0.2s, box-shadow 0.3s;
    position: relative;
    overflow: hidden;
  }

  .cta:hover { transform: scale(1.05); box-shadow: 0 6px 20px rgba(232, 100, 74, 0.35); }

  .cta-shine::after {
    content: '';
    position: absolute;
    top: 0; left: -100%;
    width: 60%; height: 100%;
    background: linear-gradient(90deg, transparent, rgba(255,255,255,0.4), transparent);
    animation: shine 3s ease-in-out infinite;
  }

  @keyframes shine { 0% { left: -100%; } 50% { left: 150%; } 100% { left: 150%; } }

  .cta-outline {
    display: inline-block;
    border: 2px solid var(--bleu);
    color: var(--bleu);
    padding: 1rem 2.5rem;
    border-radius: 50px;
    font-size: 1.05rem;
    font-weight: 600;
    transition: all 0.3s ease;
  }

  .cta-outline:hover { background-color: var(--bleu); color: var(--blanc); }

  .benefices { max-width: 1100px; margin: 0 auto; padding: 5rem 2rem; text-align: center; position: relative; z-index: 1; }
  .benefices h2 { font-size: 2rem; color: var(--bleu); margin-bottom: 3rem; font-weight: 600; }

  .cards { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 1.5rem; }

  .card {
    background-color: var(--blanc);
    border-radius: 16px;
    padding: 2rem 1.5rem;
    text-align: center;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
    transition: transform 0.15s ease-out, box-shadow 0.15s ease-out, border-color 0.15s ease-out;
    border: 2px solid transparent;
    transform-origin: center bottom;
  }

  .card .icon-bounce { margin: 0 auto 1rem; }
  .card h3 { color: var(--bleu); font-size: 1.15rem; margin-bottom: 0.75rem; font-weight: 600; }
  .card p { font-size: 0.92rem; color: var(--texte); line-height: 1.7; opacity: 0.85; }

  .etapes { max-width: 1000px; margin: 0 auto; padding: 5rem 2rem; text-align: center; position: relative; z-index: 1; }
  .etapes h2 { font-size: 2rem; color: var(--bleu); margin-bottom: 3rem; font-weight: 600; }
  .etapes-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 2rem; }

  .etape { padding: 1.5rem; display: block; color: inherit; }

  .etape-link {
    border-radius: 16px;
    transition: transform 0.15s ease-out, box-shadow 0.15s ease-out, background 0.15s ease-out;
    cursor: pointer;
  }

  .etape-link:hover { transform: translateY(-4px); background: var(--blanc); box-shadow: 0 8px 25px rgba(0, 0, 0, 0.08); }

  .etape-num {
    display: inline-flex; align-items: center; justify-content: center;
    width: 52px; height: 52px; border-radius: 50%;
    background-color: var(--jaune); color: var(--blanc);
    font-size: 1.4rem; font-weight: 700; margin-bottom: 1.2rem;
    box-shadow: 0 3px 10px rgba(245, 166, 35, 0.3);
    transition: transform 0.15s ease-out, box-shadow 0.15s ease-out;
  }

  .etape-link:hover .etape-num { transform: scale(1.3); box-shadow: 0 6px 20px rgba(245, 166, 35, 0.5); }

  .etape h3 { color: var(--bleu); font-size: 1.1rem; margin-bottom: 0.75rem; font-weight: 600; }
  .etape p { font-size: 0.92rem; color: var(--texte); opacity: 0.85; line-height: 1.7; }

  .pourquoi { max-width: 1100px; margin: 0 auto; padding: 5rem 2rem; text-align: center; position: relative; z-index: 1; }
  .pourquoi h2 { font-size: 2rem; color: var(--bleu); margin-bottom: 1rem; font-weight: 600; }
  .pourquoi-intro { font-size: 1.05rem; color: var(--texte); max-width: 700px; margin: 0 auto 3rem; line-height: 1.8; opacity: 0.85; }
  .pourquoi-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(230px, 1fr)); gap: 1.5rem; }

  .pourquoi-item {
    background-color: var(--blanc);
    border-left: 4px solid var(--jaune);
    border-radius: 0 16px 16px 0;
    padding: 1.5rem;
    text-align: left;
    transition: transform 0.15s ease-out, box-shadow 0.15s ease-out, border-left-color 0.15s ease-out;
    transform-origin: center bottom;
  }

  .pourquoi-item .icon-bounce { width: 52px; height: 52px; border-radius: 12px; margin-bottom: 0.75rem; }
  .pourquoi-item h3 { color: var(--bleu); font-size: 1.05rem; margin-bottom: 0.5rem; font-weight: 600; }
  .pourquoi-item p { font-size: 0.92rem; color: var(--texte); line-height: 1.7; opacity: 0.85; }

  .chiffres { background: linear-gradient(135deg, #1A6B5C 0%, #2BAB7C 100%); padding: 4rem 2rem; text-align: center; position: relative; z-index: 1; }
  .chiffres-grid { max-width: 900px; margin: 0 auto; display: grid; grid-template-columns: repeat(4, 1fr); gap: 2rem; }
  .chiffre-item { padding: 1.5rem; }

  .chiffre-link {
    display: block; color: inherit; border-radius: 12px;
    transition: transform 0.12s ease-out, background 0.12s ease-out;
    cursor: pointer;
  }

  .chiffre-link:hover { transform: translateY(-4px) scale(1.05); background: rgba(255,255,255,0.15); }

  .chiffre-num { font-size: 3.5rem; font-weight: 700; color: var(--blanc); line-height: 1; display: inline; transition: transform 0.2s ease; }
  .chiffre-suffix { font-size: 2.2rem; font-weight: 700; color: var(--jaune); }
  .chiffre-item p { font-size: 0.95rem; color: rgba(255,255,255,0.8); margin-top: 0.5rem; }

  .cta-final { text-align: center; padding: 5rem 2rem; background: var(--creme); color: var(--texte); position: relative; z-index: 1; }
  .cta-final h2 { font-size: 2rem; margin-bottom: 1rem; font-weight: 600; color: var(--bleu); }
  .cta-final p { font-size: 1.15rem; margin-bottom: 2.5rem; opacity: 0.85; }
  .cta-final .cta { background: linear-gradient(135deg, var(--corail), #F5A623); color: var(--blanc); font-weight: 700; }

  @media (max-width: 768px) {
    .hero h1 { font-size: 2rem; }
    .hero { padding: 2rem 1.5rem; }
    .benefices, .etapes, .pourquoi { padding: 3rem 1.5rem; }
    .chiffres { padding: 3rem 1.5rem; }
    .chiffres-grid { grid-template-columns: repeat(2, 1fr); gap: 1rem; }
    .chiffre-num { font-size: 2.5rem; }
    .cta-final { padding: 3rem 1.5rem; }
  }
</style>

<script>
  const symbols = document.querySelectorAll('.symbol');

  document.addEventListener('mousemove', (e) => {
    const mx = e.clientX / window.innerWidth - 0.5;
    const my = e.clientY / window.innerHeight - 0.5;
    symbols.forEach((sym, i) => {
      const speed = (i + 1) * 40;
      const floatY = Math.sin(Date.now() / 1000 + i) * 15;
      sym.style.transform = `translate(${mx * speed}px, ${my * speed + floatY}px) rotate(${mx * 15}deg)`;
      sym.style.transition = 'transform 0.08s linear';
    });
  });

  function dockEffect(containerId) {
    const container = document.getElementById(containerId);
    if (!container) return;
    const items = container.children;

    container.addEventListener('mousemove', (e) => {
      const containerRect = container.getBoundingClientRect();
      const mouseX = e.clientX;
      const mouseY = e.clientY;

      Array.from(items).forEach((item) => {
        const rect = item.getBoundingClientRect();
        const itemCenterX = rect.left + rect.width / 2;
        const itemCenterY = rect.top + rect.height / 2;
        const dist = Math.sqrt(Math.pow(mouseX - itemCenterX, 2) + Math.pow(mouseY - itemCenterY, 2));
        const maxDist = 300;
        const scale = Math.max(1, 1.08 - (dist / maxDist) * 0.08 + 0.08);
        const clampedScale = Math.min(scale, 1.08);
        const shadow = dist < maxDist ? `0 ${8 + (1 - dist/maxDist) * 12}px ${20 + (1 - dist/maxDist) * 20}px rgba(0,0,0,${0.05 + (1 - dist/maxDist) * 0.1})` : '0 4px 15px rgba(0,0,0,0.05)';
        const borderColor = dist < 150 ? 'var(--jaune)' : 'transparent';

        item.style.transform = `scale(${clampedScale})`;
        item.style.boxShadow = shadow;
        if (item.classList.contains('card')) item.style.borderColor = borderColor;
        if (item.classList.contains('pourquoi-item')) item.style.borderLeftColor = dist < 150 ? 'var(--corail)' : 'var(--jaune)';
      });
    });

    container.addEventListener('mouseleave', () => {
      Array.from(items).forEach((item) => {
        item.style.transform = 'scale(1)';
        item.style.boxShadow = '0 4px 15px rgba(0,0,0,0.05)';
        if (item.classList.contains('card')) item.style.borderColor = 'transparent';
        if (item.classList.contains('pourquoi-item')) item.style.borderLeftColor = 'var(--jaune)';
      });
    });
  }

  dockEffect('cards-dock');
  dockEffect('pourquoi-dock');

  const counterObserver = new IntersectionObserver((entries) => {
    entries.forEach(entry => {
      if (entry.isIntersecting) {
        const counters = entry.target.querySelectorAll('.chiffre-num');
        counters.forEach(counter => {
          const target = parseInt(counter.dataset.target);
          const duration = 1500;
          const step = Math.ceil(target / (duration / 30));
          let current = 0;
          const timer = setInterval(() => {
            current += step;
            if (current >= target) {
              current = target;
              clearInterval(timer);
              counter.style.transform = 'scale(1.15)';
              setTimeout(() => { counter.style.transform = 'scale(1)'; }, 200);
            }
            counter.textContent = current;
          }, 30);
        });
        counterObserver.unobserve(entry.target);
      }
    });
  }, { threshold: 0.3 });

  const chiffresSection = document.querySelector('.chiffres');
  if (chiffresSection) counterObserver.observe(chiffresSection);
</script>
