<script>
  // Slider des avis + compteurs animés, relancés à chaque arrivée sur l'accueil (View Transitions)
  document.addEventListener('astro:page-load', () => {
    const slides = document.querySelectorAll('.slide');
    const dotsContainer = document.getElementById('slider-dots');
    if (!slides.length || !dotsContainer) return;
    let currentSlide = 0;
    slides.forEach((_, i) => {
      const dot = document.createElement('span');
      dot.className = 'slider-dot' + (i === 0 ? ' active' : '');
      dot.addEventListener('click', () => goTo(i));
      dotsContainer.appendChild(dot);
    });
    function goTo(n) {
      slides[currentSlide].classList.remove('active');
      dotsContainer.children[currentSlide].classList.remove('active');
      currentSlide = (n + slides.length) % slides.length;
      slides[currentSlide].classList.add('active');
      dotsContainer.children[currentSlide].classList.add('active');
    }
    document.getElementById('prev-btn').addEventListener('click', () => goTo(currentSlide - 1));
    document.getElementById('next-btn').addEventListener('click', () => goTo(currentSlide + 1));
    const autoSlide = setInterval(() => goTo(currentSlide + 1), 5000);

    const counterObserver = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting) {
          entry.target.querySelectorAll('.chiffre-num').forEach(counter => {
            const target = parseInt(counter.dataset.target);
            const step = Math.ceil(target / 50);
            let val = 0;
            const timer = setInterval(() => {
              val += step;
              if (val >= target) { val = target; clearInterval(timer); counter.style.transform = 'scale(1.15)'; setTimeout(() => { counter.style.transform = 'scale(1)'; }, 200); }
              counter.textContent = val;
            }, 30);
          });
          counterObserver.unobserve(entry.target);
        }
      });
    }, { threshold: 0.3 });
    const chiffresSection = document.querySelector('.chiffres');
    if (chiffresSection) counterObserver.observe(chiffresSection);

    document.addEventListener('astro:before-swap', () => {
      clearInterval(autoSlide);
      counterObserver.disconnect();
    }, { once: true });
  });
</script>

<script>
  // Roue « Pourquoi le soroban ? » : au clic, le quart jaune tourne vers la zone et le texte change
  function initRoue() {
    const roue = document.querySelector<HTMLElement>('.roue');
    if (!roue) return;
    const zones = roue.querySelectorAll<HTMLButtonElement>('.roue-zone');
    const textes = document.querySelectorAll<HTMLElement>('.roue-texte');
    const indicateur = roue.querySelector<HTMLElement>('.roue-indicateur')!;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let actif = 0;
    let rotation = 0;
    let auto: number | undefined;
    let priseEnMain = false;

    function afficher(index: number) {
      // Tourne toujours par le chemin le plus court (jamais 270° dans le mauvais sens)
      let pas = (index - actif + 4) % 4;
      if (pas === 3) pas = -1;
      rotation += pas * 90;
      indicateur.style.transform = `rotate(${rotation}deg)`;
      actif = index;
      zones.forEach((z, i) => z.setAttribute('aria-selected', String(i === index)));
      textes.forEach((t, i) => t.classList.toggle('is-active', i === index));
    }

    zones.forEach((zone, i) => zone.addEventListener('click', () => {
      priseEnMain = true; // le visiteur a pris la main : plus de rotation automatique
      clearInterval(auto);
      afficher(i);
    }));

    // Rotation automatique toutes les 5 s, seulement quand la roue est visible à l'écran
    const observer = new IntersectionObserver(([entry]) => {
      clearInterval(auto);
      if (entry.isIntersecting && !priseEnMain && !reduceMotion) {
        auto = window.setInterval(() => afficher((actif + 1) % 4), 5000);
      }
    }, { threshold: 0.5 });
    observer.observe(roue);

    // Nettoyage avant de quitter la page (View Transitions)
    document.addEventListener('astro:before-swap', () => {
      clearInterval(auto);
      observer.disconnect();
    }, { once: true });
  }
  document.addEventListener('astro:page-load', initRoue);
</script>

<script>
  // Barre « La méthode » : au clic, la pilule blanche glisse vers la case et le texte change
  function initAtouts(bloc: HTMLElement) {
    const barre = bloc.querySelector<HTMLElement>('.atouts-barre')!;
    const atouts = barre.querySelectorAll<HTMLButtonElement>('.atout');
    const textes = bloc.querySelectorAll<HTMLElement>('.atout-texte');
    const indicateur = barre.querySelector<HTMLElement>('.atouts-indicateur')!;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    let actif = 0;
    let auto: number | undefined;
    let priseEnMain = false;

    // Place la pilule sous la case active (fonctionne aussi en 2×2 sur mobile)
    function placer() {
      const a = atouts[actif];
      indicateur.style.width = `${a.offsetWidth}px`;
      indicateur.style.height = `${a.offsetHeight}px`;
      indicateur.style.transform = `translate(${a.offsetLeft}px, ${a.offsetTop}px)`;
    }

    function afficher(index: number) {
      actif = index;
      atouts.forEach((a, i) => a.setAttribute('aria-selected', String(i === index)));
      textes.forEach((t, i) => t.classList.toggle('is-active', i === index));
      placer();
    }

    atouts.forEach((atout, i) => atout.addEventListener('click', () => {
      priseEnMain = true; // le visiteur a pris la main : plus de défilement automatique
      clearInterval(auto);
      afficher(i);
    }));

    placer();
    // Active le glissement une fois Poppins chargée et la pilule à sa taille finale
    document.fonts.ready.then(() => {
      placer();
      requestAnimationFrame(() => barre.classList.add('is-ready'));
    });
    window.addEventListener('resize', placer);

    // Défilement automatique toutes les 5 s, seulement quand la barre est visible à l'écran
    const observer = new IntersectionObserver(([entry]) => {
      clearInterval(auto);
      if (entry.isIntersecting && !priseEnMain && !reduceMotion) {
        auto = window.setInterval(() => afficher((actif + 1) % atouts.length), 5000);
      }
    }, { threshold: 0.5 });
    observer.observe(barre);

    // Nettoyage avant de quitter la page (View Transitions)
    document.addEventListener('astro:before-swap', () => {
      clearInterval(auto);
      observer.disconnect();
      window.removeEventListener('resize', placer);
    }, { once: true });
  }
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll<HTMLElement>('.atouts').forEach(initAtouts);
  });
</script>
