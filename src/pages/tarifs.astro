---
import Base from '../layouts/Base.astro';
---

<Base title="Tarifs">

  <section class="tarifs-hero fade-in">
    <h1>Nos <span class="highlight">tarifs</span></h1>
    <p>Des formules adaptées à chaque besoin. Plus tu t'engages, plus le tarif est avantageux !</p>
  </section>

  <section class="packs fade-in">

    <div class="pack">
      <div class="pack-header individuel">
        <h2>👤 Individuel</h2>
        <p class="pack-desc">Cours particulier 1-to-1. Attention 100% sur ton enfant.</p>
      </div>
      <div class="pack-body">
        <div class="formule">
          <div class="formule-info">
            <h3>À l'unité</h3>
            <p>1 heure de cours</p>
          </div>
          <div class="formule-prix">
            <span class="prix">15€</span>
            <span class="par-heure">/ heure</span>
          </div>
        </div>
        <div class="formule populaire">
          <div class="formule-tag">Le plus choisi</div>
          <div class="formule-info">
            <h3>Pack 4h</h3>
            <p>1 mois de cours (1h/semaine)</p>
          </div>
          <div class="formule-prix">
            <span class="prix">50€</span>
            <span class="par-heure">soit 12,50€ / heure</span>
          </div>
        </div>
        <div class="formule">
          <div class="formule-info">
            <h3>Pack 12h</h3>
            <p>3 mois de cours (1h/semaine)</p>
          </div>
          <div class="formule-prix">
            <span class="prix">130€</span>
            <span class="par-heure">soit 10,80€ / heure</span>
          </div>
        </div>
      </div>
    </div>

    <div class="pack">
      <div class="pack-header groupe">
        <h2>👥 Groupe</h2>
        <p class="pack-desc">Petits groupes. Dynamique collective et entraide entre enfants.</p>
      </div>
      <div class="pack-body">
        <div class="formule">
          <div class="formule-info">
            <h3>À l'unité</h3>
            <p>1 heure de cours</p>
          </div>
          <div class="formule-prix">
            <span class="prix">10€</span>
            <span class="par-heure">/ heure</span>
          </div>
        </div>
        <div class="formule populaire">
          <div class="formule-tag">Le plus choisi</div>
          <div class="formule-info">
            <h3>Mensuel</h3>
            <p>4h/mois (1h/semaine)</p>
          </div>
          <div class="formule-prix">
            <span class="prix">35€</span>
            <span class="par-heure">soit 8,75€ / heure</span>
          </div>
        </div>
        <div class="formule">
          <div class="formule-info">
            <h3>Trimestriel</h3>
            <p>12h de cours (1h/semaine, 3 mois)</p>
          </div>
          <div class="formule-prix">
            <span class="prix">90€</span>
            <span class="par-heure">soit 7,50€ / heure</span>
          </div>
        </div>
      </div>
    </div>

  </section>

  <section class="tarifs-info fade-in">
    <div class="info-cards">
      <div class="info-card">
        <span>🎁</span>
        <p><strong>Cours d'essai à 5€</strong> — teste la méthode et vois si ça plaît à ton enfant.</p>
      </div>
      <div class="info-card">
        <span>💻</span>
        <p><strong>100% en ligne</strong> — cours en visio depuis chez toi, pas de déplacement.</p>
      </div>
      <div class="info-card">
        <span>📦</span>
        <p><strong>Commande ton soroban</strong> — retrouve le boulier idéal dans notre boutique.</p>
      </div>
    </div>
  </section>

  <section class="cta-tarifs fade-in">
    <h2>Envie d'essayer ?</h2>
    <p>Teste la méthode avec un premier cours à seulement 5€.</p>
    <a href="/reservation" class="cta">Cours d'essai — 5€</a>
  </section>

</Base>

<style>
  .tarifs-hero {
    max-width: 800px;
    margin: 0 auto;
    padding: 4rem 2rem 2rem;
    text-align: center;
  }

  .tarifs-hero h1 {
    font-size: 2.5rem;
    color: var(--bleu);
    font-weight: 700;
    margin-bottom: 1.5rem;
  }

  .highlight {
    color: var(--corail);
  }

  .tarifs-hero p {
    font-size: 1.1rem;
    color: var(--texte);
    opacity: 0.85;
    line-height: 1.8;
  }

  .packs {
    max-width: 1100px;
    margin: 0 auto;
    padding: 3rem 2rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
    gap: 2rem;
  }

  .pack {
    background-color: var(--blanc);
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .pack:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.08);
  }

  .pack-header {
    padding: 2rem;
    color: var(--blanc);
  }

  .pack-header.individuel {
    background: linear-gradient(135deg, var(--bleu) 0%, var(--bleu-clair) 100%);
  }

  .pack-header.groupe {
    background: linear-gradient(135deg, #2BAB7C 0%, #34C590 100%);
  }

  .pack-header h2 {
    font-size: 1.5rem;
    font-weight: 700;
    margin-bottom: 0.5rem;
  }

  .pack-desc {
    font-size: 0.95rem;
    opacity: 0.9;
  }

  .pack-body {
    padding: 1.5rem 2rem 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .formule {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1.2rem 1.5rem;
    border-radius: 12px;
    background-color: var(--creme);
    position: relative;
  }

  .formule.populaire {
    border: 2px solid var(--jaune);
    background-color: #fffdf5;
  }

  .formule-tag {
    position: absolute;
    top: -10px;
    left: 1rem;
    background-color: var(--jaune);
    color: var(--blanc);
    font-size: 0.75rem;
    font-weight: 600;
    padding: 0.2rem 0.8rem;
    border-radius: 50px;
  }

  .formule-info h3 {
    font-size: 1rem;
    color: var(--bleu);
    font-weight: 600;
    margin-bottom: 0.2rem;
  }

  .formule-info p {
    font-size: 0.85rem;
    color: var(--texte);
    opacity: 0.7;
  }

  .formule-prix {
    text-align: right;
  }

  .prix {
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--bleu);
    display: block;
  }

  .par-heure {
    font-size: 0.8rem;
    color: var(--texte);
    opacity: 0.6;
  }

  .tarifs-info {
    max-width: 1100px;
    margin: 0 auto;
    padding: 3rem 2rem;
  }

  .info-cards {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 1.5rem;
  }

  .info-card {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    padding: 1.5rem;
    background-color: var(--blanc);
    border-radius: 12px;
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
  }

  .info-card span {
    font-size: 1.8rem;
    flex-shrink: 0;
  }

  .info-card p {
    font-size: 0.92rem;
    color: var(--texte);
    line-height: 1.6;
  }

  .cta-tarifs {
    text-align: center;
    padding: 5rem 2rem;
    background: linear-gradient(135deg, var(--bleu) 0%, var(--bleu-clair) 100%);
    color: var(--blanc);
  }

  .cta-tarifs h2 {
    font-size: 2rem;
    margin-bottom: 1rem;
    font-weight: 600;
  }

  .cta-tarifs p {
    font-size: 1.15rem;
    margin-bottom: 2.5rem;
    opacity: 0.9;
  }

  .cta {
    display: inline-block;
    background-color: var(--jaune);
    color: var(--bleu);
    padding: 1rem 2.5rem;
    border-radius: 50px;
    font-size: 1.05rem;
    font-weight: 700;
    transition: background-color 0.3s, transform 0.2s;
  }

  .cta:hover {
    background-color: #e0950f;
    transform: scale(1.03);
  }

  @media (max-width: 768px) {
    .tarifs-hero h1 {
      font-size: 2rem;
    }

    .packs {
      grid-template-columns: 1fr;
      padding: 2rem 1.5rem;
    }

    .formule {
      flex-direction: column;
      text-align: center;
      gap: 0.8rem;
    }

    .formule-prix {
      text-align: center;
    }

    .cta-tarifs {
      padding: 3rem 1.5rem;
    }
  }
</style>
