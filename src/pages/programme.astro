---
import Base from '../layouts/Base.astro';
---

<Base title="Programme">

  <section class="prog-hero fade-in">
    <h1>Le programme <span class="highlight">Soroclub</span></h1>
    <p>9 niveaux progressifs pour accompagner ton enfant du boulier physique au calcul mental pur. Chaque niveau est validé par un examen — comme les ceintures en judo !</p>
  </section>

  <section class="niveaux fade-in">

    <div class="niveau">
      <div class="niveau-badge" style="background: #2BAB7C;">Niveau 1</div>
      <div class="niveau-content">
        <h2>Niveau 1 — Les premiers pas</h2>
        <ul>
          <li>Présentation des chiffres et du soroban</li>
          <li>Addition & soustraction simples d'un seul chiffre</li>
          <li>Addition & soustraction simples de deux chiffres</li>
          <li>Addition & soustraction simples de trois chiffres</li>
          <li>Addition & soustraction mentales de chiffres simples</li>
          <li>Révision & examen</li>
        </ul>
      </div>
    </div>

    <div class="niveau">
      <div class="niveau-badge" style="background: #34B886;">Niveau 2</div>
      <div class="niveau-content">
        <h2>Niveau 2 — Les amis du soroban</h2>
        <ul>
          <li>Les petits amis de 5</li>
          <li>Les grands amis de 10</li>
          <li>Combinaisons</li>
          <li>Addition & soustraction d'un seul chiffre</li>
          <li>Addition & soustraction de deux chiffres</li>
          <li>Addition & soustraction de trois chiffres</li>
          <li>Addition & soustraction mentales d'un à trois chiffres</li>
          <li>Révision & examen</li>
        </ul>
      </div>
    </div>

    <div class="niveau">
      <div class="niveau-badge" style="background: #5EBD6E;">Niveau 3</div>
      <div class="niveau-content">
        <h2>Niveau 3 — Premiers calculs complexes</h2>
        <ul>
          <li>Addition et soustraction amis de 5 et 10 en mental</li>
          <li>Addition et soustraction de nombres à 4 chiffres</li>
          <li>Multiplication : entre des nombres à 2 et 1 chiffre</li>
          <li>Révision & examen</li>
        </ul>
      </div>
    </div>

    <div class="niveau">
      <div class="niveau-badge" style="background: #A3C540;">Niveau 4</div>
      <div class="niveau-content">
        <h2>Niveau 4 — La multiplication</h2>
        <ul>
          <li>Addition et soustraction mentales</li>
          <li>Multiplication : entre 2 et 2 chiffres</li>
          <li>Multiplication : entre 4 et 1 chiffre</li>
          <li>Multiplication : entre 3 et 2 chiffres</li>
          <li>Multiplication de 2 chiffres par 1 chiffre en mental</li>
          <li>Révision & examen</li>
        </ul>
      </div>
    </div>

    <div class="niveau">
      <div class="niveau-badge" style="background: #F5A623;">Niveau 5</div>
      <div class="niveau-content">
        <h2>Niveau 5 — La division</h2>
        <ul>
          <li>Multiplication de 2 chiffres par 2 chiffres en mental</li>
          <li>Division : nombre de 2 chiffres par 1 chiffre</li>
          <li>Division : nombre de 3 chiffres par 1 chiffre</li>
          <li>Division : 4 chiffres par 1 chiffre</li>
          <li>Division : 5 chiffres par 1 chiffre</li>
          <li>Révision & examen</li>
        </ul>
      </div>
    </div>

    <div class="niveau">
      <div class="niveau-badge" style="background: #F08C3A;">Niveau 6</div>
      <div class="niveau-content">
        <h2>Niveau 6 — Division avancée</h2>
        <ul>
          <li>Division de 2 et 3 chiffres par 1 chiffre en mental</li>
          <li>Division : 2 chiffres par 2 chiffres</li>
          <li>Division : 3 chiffres par 2 chiffres</li>
          <li>Division : 4 chiffres par 2 chiffres</li>
          <li>Révision & examen</li>
        </ul>
      </div>
    </div>

    <div class="niveau">
      <div class="niveau-badge" style="background: #E8644A;">Niveau 7</div>
      <div class="niveau-content">
        <h2>Niveau 7 — Toutes opérations</h2>
        <ul>
          <li>Addition & soustraction (mental & soroban)</li>
          <li>Multiplication (mental & soroban)</li>
          <li>Division (mental & soroban)</li>
          <li>Révision & examen</li>
        </ul>
      </div>
    </div>

    <div class="niveau">
      <div class="niveau-badge" style="background: #D4553B;">Niveau 8</div>
      <div class="niveau-content">
        <h2>Niveau 8 — Les décimaux</h2>
        <ul>
          <li>Opérations mixtes (mental & soroban)</li>
          <li>Introduction des nombres décimaux</li>
          <li>Addition et soustraction de nombres décimaux</li>
          <li>Révision & examen</li>
        </ul>
      </div>
    </div>

    <div class="niveau">
      <div class="niveau-badge" style="background: #1B3A5C;">Niveau 9</div>
      <div class="niveau-content">
        <h2>Niveau 9 — La maîtrise</h2>
        <ul>
          <li>Opérations mixtes (mental & soroban)</li>
          <li>Addition et soustraction de nombres décimaux</li>
          <li>Multiplication de nombres entiers</li>
          <li>Division de nombres entiers</li>
          <li>Révision & examen final</li>
        </ul>
      </div>
    </div>

  </section>

  <section class="examen fade-in">
    <h2>🎓 Validation par examen</h2>
    <p>Chaque niveau se termine par un examen. L'enfant sait toujours où il en est et ce qu'il lui reste à accomplir. Pas de pression — chacun avance à son rythme.</p>
  </section>

  <section class="cta-programme fade-in">
    <h2>Prêt à commencer ?</h2>
    <p>Découvre le soroban avec nous !</p>
    <a href="/reservation" class="cta">Cours d'essai — 5€</a>
  </section>

</Base>

<style>
  .prog-hero {
    max-width: 800px;
    margin: 0 auto;
    padding: 4rem 2rem 2rem;
    text-align: center;
  }

  .prog-hero h1 {
    font-size: 2.5rem;
    color: var(--bleu);
    font-weight: 700;
    margin-bottom: 1.5rem;
  }

  .highlight {
    color: var(--corail);
  }

  .prog-hero p {
    font-size: 1.1rem;
    color: var(--texte);
    opacity: 0.85;
    line-height: 1.8;
  }

  .niveaux {
    max-width: 900px;
    margin: 0 auto;
    padding: 3rem 2rem;
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
  }

  .niveau {
    display: flex;
    align-items: flex-start;
    gap: 1.5rem;
    background-color: var(--blanc);
    border-radius: 16px;
    padding: 2rem;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
    transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .niveau:hover {
    transform: translateX(6px);
    box-shadow: 0 8px 25px rgba(0, 0, 0, 0.08);
  }

  .niveau-badge {
    flex-shrink: 0;
    padding: 0.4rem 1.2rem;
    border-radius: 50px;
    font-size: 0.85rem;
    color: var(--blanc);
    white-space: nowrap;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow: 0 3px 10px rgba(0, 0, 0, 0.15);
  }

  .niveau-content h2 {
    font-size: 1.2rem;
    color: var(--bleu);
    font-weight: 600;
    margin-bottom: 0.75rem;
  }

  .niveau-content ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .niveau-content li {
    font-size: 0.9rem;
    color: var(--texte);
    opacity: 0.85;
    padding-left: 1.5rem;
    position: relative;
    line-height: 1.6;
  }

  .niveau-content li::before {
    content: "✓";
    position: absolute;
    left: 0;
    color: var(--jaune);
    font-weight: 700;
  }

  .examen {
    max-width: 700px;
    margin: 0 auto;
    padding: 3rem 2rem;
    text-align: center;
  }

  .examen h2 {
    font-size: 1.8rem;
    color: var(--bleu);
    margin-bottom: 1rem;
    font-weight: 600;
  }

  .examen p {
    font-size: 1rem;
    color: var(--texte);
    opacity: 0.85;
    line-height: 1.8;
  }

  .cta-programme {
    text-align: center;
    padding: 5rem 2rem;
    background: linear-gradient(135deg, var(--bleu) 0%, var(--bleu-clair) 100%);
    color: var(--blanc);
  }

  .cta-programme h2 {
    font-size: 2rem;
    margin-bottom: 1rem;
    font-weight: 600;
  }

  .cta-programme p {
    font-size: 1.15rem;
    margin-bottom: 2.5rem;
    opacity: 0.9;
  }

  .cta {
    display: inline-block;
    background-color: var(--jaune);
    color: var(--bleu);
    padding: 1rem 2.5rem;
    border-radius: 50px;
    font-size: 1.05rem;
    font-weight: 700;
    transition: background-color 0.3s, transform 0.2s;
  }

  .cta:hover {
    background-color: #e0950f;
    transform: scale(1.03);
  }

  @media (max-width: 768px) {
    .prog-hero h1 {
      font-size: 2rem;
    }

    .prog-hero {
      padding: 2rem 1.5rem 1rem;
    }

    .niveaux {
      padding: 2rem 1.5rem;
    }

    .niveau {
      flex-direction: column;
      align-items: center;
      text-align: center;
      padding: 1.5rem;
    }

    .niveau-content li {
      text-align: left;
    }

    .cta-programme {
      padding: 3rem 1.5rem;
    }
  }
</style>
