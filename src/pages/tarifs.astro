---
import Base from '../layouts/Base.astro';
import { stripe } from '../data/stripe';
import CarteSoutien from '../components/CarteSoutien.astro';
import BandeauEssai from '../components/BandeauEssai.astro';
---

<Base title="Tarifs">

  <section class="tarifs-hero fade-in">
    <h1>Nos <span class="highlight">tarifs</span></h1>
    <p>Des formules adaptées à chaque besoin. Plus tu t'engages, plus le tarif est avantageux !</p>
  </section>

  <div class="tabs" role="tablist" aria-label="Choix de la formule">
    <span class="tab-indicator" aria-hidden="true"></span>
    <button class="tab" role="tab" id="tab-soroban" data-tab="soroban" aria-controls="panel-soroban" aria-selected="true">Soroban</button>
    <button class="tab" role="tab" id="tab-soutien" data-tab="soutien" aria-controls="panel-soutien" aria-selected="false">Soutien scolaire</button>
  </div>

  <div class="tab-panel" role="tabpanel" id="panel-soroban" aria-labelledby="tab-soroban">
  <section class="packs">

    <div class="pack fade-in">
      <div class="pack-header individuel">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 21v-2a4 4 0 0 0-4-4H9a4 4 0 0 0-4 4v2"/><circle cx="12" cy="7" r="4"/></svg>
        <h2>Individuel</h2>
        <p class="pack-desc">Cours particulier 1-to-1. Attention 100% sur ton enfant.</p>
        <p class="pack-rythme"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>1 cours d'1h par semaine</p>
      </div>
      <div class="pack-body">
        <div class="formule">
          <div class="formule-info"><h3>1 mois</h3></div>
          <div class="formule-prix">
            <div class="formule-montant"><span class="prix">60€</span><span class="par-heure">par mois</span></div>
            <a href={stripe.individuel1m} target="_blank" class="btn-acheter">Acheter</a>
          </div>
        </div>
        <div class="formule">
          <div class="formule-info"><h3>3 mois</h3><span class="economie">21€ économisés</span></div>
          <div class="formule-prix">
            <div class="formule-montant"><span class="prix">159€</span><span class="par-heure">soit 53€ par mois</span></div>
            <a href={stripe.individuel3m} target="_blank" class="btn-acheter">Acheter</a>
          </div>
        </div>
        <div class="formule populaire">
          <div class="formule-tag">⭐ Le plus choisi</div>
          <div class="formule-info"><h3>6 mois</h3><span class="economie">61€ économisés</span></div>
          <div class="formule-prix">
            <div class="formule-montant"><span class="prix">299€</span><span class="par-heure">soit 49,83€ par mois</span></div>
            <a href={stripe.individuel6m} target="_blank" class="btn-acheter">Acheter</a>
          </div>
        </div>
        <div class="formule meilleur-prix">
          <div class="formule-tag">Meilleur prix</div>
          <div class="formule-info"><h3>Année</h3><p class="periode">d'octobre à juin</p><span class="economie">141€ économisés</span></div>
          <div class="formule-prix">
            <div class="formule-montant"><span class="prix">399€</span><span class="par-heure">soit 44,33€ par mois</span></div>
            <a href={stripe.individuelAn} target="_blank" class="btn-acheter">Acheter</a>
          </div>
        </div>
      </div>
    </div>

    <div class="pack fade-in">
      <div class="pack-header groupe">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><path d="M16 3.128a4 4 0 0 1 0 7.744"/><path d="M22 21v-2a4 4 0 0 0-3-3.87"/><circle cx="9" cy="7" r="4"/></svg>
        <h2>Groupe</h2>
        <p class="pack-desc">Petits groupes, entraide et suivi personnalisé de chaque enfant.</p>
        <p class="pack-rythme"><svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/></svg>1 cours d'1h par semaine</p>
      </div>
      <div class="pack-body">
        <div class="formule">
          <div class="formule-info"><h3>1 mois</h3></div>
          <div class="formule-prix">
            <div class="formule-montant"><span class="prix">40€</span><span class="par-heure">par mois</span></div>
            <a href={stripe.groupe1m} target="_blank" class="btn-acheter">Acheter</a>
          </div>
        </div>
        <div class="formule">
          <div class="formule-info"><h3>3 mois</h3><span class="economie">11€ économisés</span></div>
          <div class="formule-prix">
            <div class="formule-montant"><span class="prix">109€</span><span class="par-heure">soit 36,33€ par mois</span></div>
            <a href={stripe.groupe3m} target="_blank" class="btn-acheter">Acheter</a>
          </div>
        </div>
        <div class="formule populaire">
          <div class="formule-tag">⭐ Le plus choisi</div>
          <div class="formule-info"><h3>6 mois</h3><span class="economie">41€ économisés</span></div>
          <div class="formule-prix">
            <div class="formule-montant"><span class="prix">199€</span><span class="par-heure">soit 33,17€ par mois</span></div>
            <a href={stripe.groupe6m} target="_blank" class="btn-acheter">Acheter</a>
          </div>
        </div>
        <div class="formule meilleur-prix">
          <div class="formule-tag">Meilleur prix</div>
          <div class="formule-info"><h3>Année</h3><p class="periode">d'octobre à juin</p><span class="economie">81€ économisés</span></div>
          <div class="formule-prix">
            <div class="formule-montant"><span class="prix">279€</span><span class="par-heure">soit 31€ par mois</span></div>
            <a href={stripe.groupeAn} target="_blank" class="btn-acheter">Acheter</a>
          </div>
        </div>
      </div>
    </div>

  </section>
  </div>

  <div class="tab-panel" role="tabpanel" id="panel-soutien" aria-labelledby="tab-soutien" hidden>
  <section class="soutien-tarifs">
    <CarteSoutien />
  </section>
  </div>

  <script is:inline>
    // Exécuté avant le premier affichage : ouvre directement l'onglet Soutien si l'URL finit par #soutien (évite le flash Soroban → Soutien)
    if (location.hash === '#soutien') {
      document.getElementById('tab-soroban').setAttribute('aria-selected', 'false');
      document.getElementById('tab-soutien').setAttribute('aria-selected', 'true');
      document.getElementById('panel-soroban').hidden = true;
      document.getElementById('panel-soutien').hidden = false;
    }
  </script>

  <section class="reassurance fade-in">
    <div class="reassurance-grid">
      <div class="reassurance-item" style="--c: var(--bleu);">
        <span class="reassurance-icon"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m16 11 2 2 4-4"/><path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg></span>
        <h3>Suivi personnalisé</h3>
        <p>Chaque enfant est suivi individuellement, à son rythme.</p>
      </div>
      <div class="reassurance-item" style="--c: var(--teal);">
        <span class="reassurance-icon"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect width="20" height="14" x="2" y="3" rx="2"/><line x1="8" x2="16" y1="21" y2="21"/><line x1="12" x2="12" y1="17" y2="21"/></svg></span>
        <h3>100% en ligne</h3>
        <p>Les cours se font en visio, depuis chez toi.</p>
      </div>
      <a href="/boutique" class="reassurance-item reassurance-lien" style="--c: var(--corail);">
        <span class="reassurance-icon"><svg width="26" height="26" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M16 10a4 4 0 0 1-8 0"/><path d="M3.103 6.034h17.794"/><path d="M3.4 5.467a2 2 0 0 0-.4 1.2V20a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2V6.667a2 2 0 0 0-.4-1.2l-2-2.667A2 2 0 0 0 17 2H7a2 2 0 0 0-1.6.8z"/></svg></span>
        <h3>Ton soroban</h3>
        <p>Le boulier idéal pour s'entraîner, dans notre boutique.</p>
        <span class="reassurance-voir">Voir la boutique <svg class="arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></span>
      </a>
    </div>
    <BandeauEssai />
    <p class="question">Une question ? <a href="/contact">Contacte-nous <svg class="arrow" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14"/><path d="m12 5 7 7-7 7"/></svg></a></p>
  </section>

</Base>

<style>
  .tarifs-hero {
    max-width: 800px;
    margin: 0 auto;
    padding: 4rem 2rem 2rem;
    text-align: center;
  }


  .tarifs-hero h1 { font-size: 2.5rem; color: var(--bleu); font-weight: 700; margin-bottom: 1.5rem; }
  .highlight { color: var(--corail); }
  .tarifs-hero p { font-size: 1.1rem; color: var(--texte); opacity: 0.85; line-height: 1.8; }

  .tabs {
    position: relative; display: flex; gap: 0.5rem;
    width: fit-content; margin: 0 auto;
    padding: 0.4rem; background: var(--blanc);
    border-radius: 50px; box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
  }

  .tab {
    font-family: 'Poppins', sans-serif; font-size: 1rem; font-weight: 600;
    color: var(--bleu); background: none; border: none;
    padding: 0.7rem 1.8rem; border-radius: 50px; cursor: pointer;
    position: relative; z-index: 1;
    transition: color 0.3s ease;
  }

  .tab[aria-selected="false"]:hover { color: var(--corail); }
  .tab[aria-selected="true"] { color: var(--blanc); }
  .tab:focus-visible { outline: 2px solid var(--jaune); outline-offset: 2px; }

  /* Pilule bleue qui glisse sous l'onglet actif (positionnée par le script) */
  .tab-indicator {
    position: absolute; top: 0.4rem; left: 0;
    height: calc(100% - 0.8rem); width: 0;
    background: var(--bleu); border-radius: 50px;
  }
  .tabs.is-ready .tab-indicator { transition: transform 0.35s cubic-bezier(0.22, 1, 0.36, 1), width 0.35s cubic-bezier(0.22, 1, 0.36, 1); }
  /* Avant que le script ait placé la pilule : fond bleu directement sur l'onglet actif */
  .tabs:not(.is-ready) .tab[aria-selected="true"] { background: var(--bleu); }

  /* Fondu enchaîné : l'ancien panneau s'efface, le nouveau apparaît en montant légèrement */
  .tab-panel { transition: opacity 0.15s ease; }
  .tab-panel.is-leaving { opacity: 0; }
  .tab-panel.is-entering { animation: tabEnter 0.3s cubic-bezier(0.22, 1, 0.36, 1); }
  @keyframes tabEnter { from { opacity: 0; transform: translateY(6px); } to { opacity: 1; transform: none; } }

  @media (prefers-reduced-motion: reduce) {
    .tab, .tab-panel, .tabs.is-ready .tab-indicator { transition: none; animation: none; }
  }

  .packs {
    max-width: 1100px;
    margin: 0 auto;
    padding: 3rem 2rem;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(400px, 1fr));
    gap: 2rem;
  }

  .pack {
    background-color: var(--blanc);
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 4px 15px rgba(0, 0, 0, 0.05);
    transition: transform 0.2s ease, box-shadow 0.2s ease;
    border: 2px solid transparent;
  }

  .pack:hover { transform: translateY(-4px); box-shadow: 0 12px 30px rgba(0, 0, 0, 0.1); border-color: var(--jaune); }

  /* En-têtes Individuel / Groupe de même hauteur → lignes de prix alignées d'une carte à l'autre */
  .packs .pack { display: grid; grid-row: span 2; grid-template-rows: subgrid; row-gap: 0; }

  .pack-header { padding: 2rem; color: var(--blanc); display: flex; flex-direction: column; gap: 0.5rem; }
  .pack-header svg { margin-bottom: 0.3rem; }
  .pack-header.individuel { background: linear-gradient(135deg, #1B3A5C 0%, #2A5580 100%); }
  .pack-header.groupe { background: linear-gradient(135deg, #1A6B5C 0%, #2BAB7C 100%); }
  .pack-header h2 { font-size: 1.5rem; font-weight: 700; }
  .pack-desc { font-size: 0.95rem; opacity: 0.9; }
  /* Pastille du rythme des cours, bien visible, calée en bas de l'en-tête (alignée d'une carte à l'autre) */
  .pack-rythme { align-self: flex-start; display: inline-flex; align-items: center; gap: 0.5rem; margin-top: auto; padding: 0.45rem 1rem; border-radius: 50px; background: rgba(255,255,255,0.18); color: var(--blanc); font-size: 0.95rem; font-weight: 600; }

  .pack-body { padding: 1.5rem 2rem 2rem; display: flex; flex-direction: column; gap: 1rem; }

  .formule {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 1rem 1.25rem;
    border-radius: 12px;
    background-color: var(--blanc);
    border: 1px solid #E3E8EE;
    position: relative;
    gap: 1rem;
    transition: background-color 0.2s ease, border-color 0.2s ease;
  }

  .formule:hover { background-color: #FAFBFC; border-color: #CBD3DD; }

  .formule.populaire { border: 2px solid var(--jaune); background-color: #FFFBF2; }
  .formule.populaire, .formule.meilleur-prix { padding-top: 1.4rem; }

  .formule-tag {
    position: absolute; top: -10px; left: 1rem;
    background-color: var(--jaune); color: var(--blanc);
    font-size: 0.75rem; font-weight: 600;
    padding: 0.2rem 0.8rem; border-radius: 50px;
  }

  .formule.meilleur-prix .formule-tag { background-color: var(--bleu); }

  .formule-info h3 { font-size: 1.05rem; color: var(--bleu); font-weight: 600; }
  .periode { font-size: 0.8rem; color: #5F6B78; }
  .economie { display: inline-block; margin-top: 0.35rem; font-size: 0.75rem; font-weight: 600; color: var(--teal); background: rgba(26,107,92,0.1); padding: 0.15rem 0.6rem; border-radius: 50px; }
  .formule-prix { display: flex; align-items: center; gap: 1.25rem; }
  .formule-montant { display: flex; flex-direction: column; align-items: flex-end; text-align: right; line-height: 1.25; }
  .prix { font-size: 1.6rem; font-weight: 700; color: var(--corail); }
  .par-heure { font-size: 0.8rem; color: #5F6B78; margin-top: 0.15rem; }

  .btn-acheter {
    display: inline-block;
    background: linear-gradient(135deg, var(--corail), #F5A623);
    color: var(--blanc);
    padding: 0.4rem 1.2rem;
    border-radius: 50px;
    font-size: 0.85rem;
    font-weight: 600;
    transition: transform 0.2s, box-shadow 0.2s, background 0.2s, color 0.2s;
    position: relative;
    overflow: hidden;
  }

  .btn-acheter:hover { transform: scale(1.05); box-shadow: 0 4px 12px rgba(232,100,74,0.3); }

  /* Seule l'offre mise en avant garde le bouton plein, les autres passent en contour */
  .formule:not(.populaire) .btn-acheter { background: none; color: var(--corail); box-shadow: inset 0 0 0 2px var(--corail); }
  .formule:not(.populaire) .btn-acheter:hover { background: var(--corail); color: var(--blanc); }

  .soutien-tarifs { max-width: 600px; margin: 0 auto; padding: 3rem 2rem; }

  .reassurance { max-width: 1000px; margin: 0 auto; padding: 3rem 2rem 4rem; }
  .reassurance-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
  .reassurance-item { display: flex; flex-direction: column; align-items: center; text-align: center; gap: 0.5rem; padding: 2rem 1.5rem; background: var(--blanc); border-radius: 16px; box-shadow: 0 4px 15px rgba(0,0,0,0.05); border: 2px solid transparent; color: inherit; }
  .reassurance-lien { transition: transform 0.2s ease, box-shadow 0.2s ease, border-color 0.2s ease; }
  .reassurance-lien:hover { transform: translateY(-4px); box-shadow: 0 8px 25px rgba(0,0,0,0.08); border-color: var(--jaune); }
  .reassurance-icon { width: 56px; height: 56px; border-radius: 16px; display: flex; align-items: center; justify-content: center; color: var(--c); background: color-mix(in srgb, var(--c) 10%, transparent); margin-bottom: 0.5rem; }
  .reassurance-item h3 { font-size: 1.1rem; font-weight: 600; color: var(--bleu); }
  .reassurance-item p { font-size: 0.92rem; color: #5F6B78; line-height: 1.6; }
  .reassurance-voir { display: inline-flex; align-items: center; gap: 0.4rem; margin-top: 0.5rem; font-size: 0.9rem; font-weight: 600; color: var(--corail); }
  .question { text-align: center; margin-top: 2rem; font-size: 1rem; color: var(--texte); }
  .question a { display: inline-flex; align-items: center; gap: 0.35rem; font-weight: 600; color: var(--teal); }

  @media (max-width: 768px) {
    .tarifs-hero h1 { font-size: 2rem; }
    .packs { grid-template-columns: 1fr; padding: 2rem 1.5rem; }
    .tab { padding: 0.6rem 1.1rem; font-size: 0.9rem; }
    .soutien-tarifs { padding: 2rem 1.5rem; }
    .pack-header { padding: 1.5rem; }
    .pack-body { padding: 1.25rem 1rem 1.5rem; }
    .formule { padding: 0.9rem 1rem; }
    .formule.populaire, .formule.meilleur-prix { padding-top: 1.3rem; }
    /* Mobile : durée + montant sur une ligne, bouton sur toute la largeur en dessous */
    .formule { flex-wrap: wrap; }
    .formule-prix { display: contents; }
    .btn-acheter { flex-basis: 100%; text-align: center; padding: 0.6rem 1rem; }
    .reassurance { padding: 2rem 1.5rem 3rem; }
    .reassurance-grid { grid-template-columns: 1fr; }
  }
</style>

<script>
  // Onglets Soroban / Soutien — /tarifs#soutien ouvre directement l'onglet Soutien
  function initTabs() {
    const tablist = document.querySelector<HTMLElement>('.tabs');
    if (!tablist) return;
    const tabs = tablist.querySelectorAll<HTMLButtonElement>('.tab');
    const indicator = tablist.querySelector<HTMLElement>('.tab-indicator')!;
    const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
    const panel = (name: string) => document.getElementById(`panel-${name}`)!;
    let current = location.hash === '#soutien' ? 'soutien' : 'soroban';
    let timer: number | undefined;

    // Place la pilule sous l'onglet actif
    function moveIndicator() {
      const tab = tablist!.querySelector<HTMLButtonElement>(`[data-tab="${current}"]`)!;
      indicator.style.width = `${tab.offsetWidth}px`;
      indicator.style.transform = `translateX(${tab.offsetLeft}px)`;
    }

    function select(name: string) {
      current = name;
      tabs.forEach(tab => tab.setAttribute('aria-selected', String(tab.dataset.tab === name)));
      moveIndicator();
    }

    // Affiche uniquement le panneau actif (+ animation d'entrée)
    function swap(animate: boolean) {
      tabs.forEach(tab => {
        const p = panel(tab.dataset.tab!);
        p.classList.remove('is-leaving', 'is-entering');
        p.hidden = tab.dataset.tab !== current;
      });
      if (animate) {
        void panel(current).offsetWidth; // relance l'animation même si on reclique vite
        panel(current).classList.add('is-entering');
      }
    }

    function showTab(name: string) {
      const leaving = panel(current);
      select(name);
      clearTimeout(timer);
      if (reduceMotion) return swap(false);
      leaving.classList.add('is-leaving');
      timer = window.setTimeout(() => swap(true), 150);
    }

    tabs.forEach(tab => tab.addEventListener('click', () => {
      const name = tab.dataset.tab!;
      if (name === current) return;
      history.replaceState(null, '', name === 'soutien' ? '#soutien' : location.pathname);
      showTab(name);
    }));

    select(current);
    swap(false);
    // Active le glissement seulement une fois Poppins chargée et la pilule à sa taille finale
    document.fonts.ready.then(() => {
      moveIndicator();
      requestAnimationFrame(() => tablist.classList.add('is-ready'));
    });
    window.addEventListener('resize', moveIndicator);

    // Nettoyage avant de quitter la page (View Transitions)
    document.addEventListener('astro:before-swap', () => {
      clearTimeout(timer);
      window.removeEventListener('resize', moveIndicator);
    }, { once: true });
  }
  document.addEventListener('astro:page-load', initTabs);
</script>
